{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "types": ["@webgpu/types", "$app/types"],
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true
    }
}
